# ══════════════════════════════════════════════════════════════
# Soulmate AI · 配置模板
# ══════════════════════════════════════════════════════════════
#
# 用法：复制成 `.env`（该文件已被 .gitignore 忽略，不会进版本库）
#
#     cp .env.example .env
#
# 所有项都有默认值 —— 本地开发不建 .env 也能直接跑。
# 每一项都能用「同名大写环境变量」覆盖（例如容器里用 -e 传入）。
# ──────────────────────────────────────────────────────────────

# ── 基础 ────────────────────────────────────────────────────
# development（本地）/ production（服务器，会开启严格校验）/ test
SOULMATE_ENV=development
# 打开后日志降级为 DEBUG，界面上会显示异常细节。生产必须 false
SOULMATE_DEBUG=false

# ── 数据目录 ────────────────────────────────────────────────
# 默认是项目下的 data/；容器里建议挂卷到 /data
# SOULMATE_DATA_DIR=./data

# ── 安全（生产必填！）────────────────────────────────────────
# 根密钥：用于派生「API Key 加密密钥」和「登录令牌签名密钥」。
# 要求：≥32 个字符的随机串。生成方式：
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ 生产环境不设置会直接拒绝启动；且**一旦设置就不能随意更换**，
#    换了之后已加密保存的 API Key 会解不开（需要重新填写）。
SOULMATE_APP_SECRET=

# 是否允许把模型地址指向内网/本机（如 Ollama、内网反代）。
# 默认 false = 挡住 SSRF。确需接内网服务时再开。
SOULMATE_ALLOW_PRIVATE_BASE_URL=false

# 模型 Key 留空时，是否回退去读**同名环境变量**（如 SILICONFLOW_API_KEY）。
# 不填 = 自动：开发/单机开、生产关（生产环境用户更多，兜底等于把服务器
#          所有者的额度开放给任何登录用户）。
# 显式 true/false 可覆盖这个自动值。
# 单人自部署且长期用 production 跑 → 填 true。
SOULMATE_PROVIDER_ENV_FALLBACK=

# ── 认证 ────────────────────────────────────────────────────
# local（本机账号库）/ oidc（Streamlit 原生 st.login）/ hybrid（两者都开）
SOULMATE_AUTH_MODE=local
# 是否允许自助注册。公开部署建议 false，改用 `soulmate create-user` 开号
SOULMATE_ALLOW_SIGNUP=true
# 管理员用户名（逗号分隔），拥有账号管理权限
SOULMATE_ADMIN_USERNAMES=admin
# 登录态有效期（小时）
SOULMATE_SESSION_TTL_HOURS=72

# ── 限流（同一进程内的令牌桶）──────────────────────────────
SOULMATE_RATE_LIMIT_CHAT_PER_MINUTE=30
SOULMATE_RATE_LIMIT_EXTRACT_PER_MINUTE=60
SOULMATE_RATE_LIMIT_LOGIN_PER_MINUTE=10
# 开号上限。注意这是**全局**桶（不按用户名）——注册时攻击者会换用户名，
# 按用户名记等于没限流；另见 docs/SECURITY.md 的「限流」一节。
SOULMATE_RATE_LIMIT_REGISTER_PER_MINUTE=10

# ── 对话 ────────────────────────────────────────────────────
# 每次请求默认携带多少条历史（侧边栏可调）
SOULMATE_DEFAULT_HISTORY_LENGTH=15
SOULMATE_MAX_HISTORY_LENGTH=30
# 单条消息字符上限（防有人贴一本书进来烧 token）
SOULMATE_MAX_MESSAGE_CHARS=8000
# 送进模型的历史总字符预算，超出从最旧丢起
SOULMATE_MAX_CONTEXT_CHARS=24000
# 普通对话超时（秒）
SOULMATE_REQUEST_TIMEOUT_SECONDS=60
# 长期记忆抽取超时（秒）—— 比对话短，它是"顺手做的事"
SOULMATE_EXTRACT_TIMEOUT_SECONDS=15
# 可重试错误的重试次数与退避基数
SOULMATE_MAX_RETRIES=2
SOULMATE_RETRY_BACKOFF_SECONDS=0.8

# ── 长期记忆 ────────────────────────────────────────────────
SOULMATE_MEMORY_ENABLED_DEFAULT=true
# 单个伴侣最多记多少条（到顶淘汰最旧）
SOULMATE_MEMORY_MAX_FACTS=200
# 每次注入 system prompt 的记忆条数上限
SOULMATE_MEMORY_INJECT_LIMIT=30

# ── 备份 ────────────────────────────────────────────────────
SOULMATE_BACKUP_ENABLED=true
# 保留最近几份
SOULMATE_BACKUP_KEEP=7